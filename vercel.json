{
  "functions": {
    "api/chat.js": { "maxDuration": 60 }
  },
  "rewrites": [
    {
      "source": "/share/:id",
      "destination": "/api/share?listing=:id"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
